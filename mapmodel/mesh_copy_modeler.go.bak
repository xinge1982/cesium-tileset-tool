/************* Mesh 克隆（重建几何 + 克隆材质贴图链） *************/
func cloneMesh(src *gltf.Document, meshIndex int, dst *gltf.Document, fidx int) (int, error) {
	if src == nil || dst == nil {
		return -1, errors.New("nil doc")
	}
	if meshIndex < 0 || meshIndex >= len(src.Meshes) || src.Meshes[meshIndex] == nil {
		return -1, fmt.Errorf("invalid mesh index %d", meshIndex)
	}
	ensureSingleBuffer(dst)
	mc := newMatCopier(src, dst)

	srcMesh := src.Meshes[meshIndex]
	out := &gltf.Mesh{Name: srcMesh.Name}
	out.Primitives = make([]*gltf.Primitive, 0, len(srcMesh.Primitives))

	for i, p := range srcMesh.Primitives {
		if p == nil {
			continue
		}
		np, err := clonePrimitive(src, p, dst, fidx)
		if err != nil {
			return -1, fmt.Errorf("primitive %d: %w", i, err)
		}

		// 克隆材质链（若有）
		if p.Material != nil {
			newMat, err := mc.cloneMaterial(*p.Material)
			if err != nil {
				return -1, fmt.Errorf("material %d: %w", *p.Material, err)
			}
			np.Material = gltf.Index(newMat)
		}
		out.Primitives = append(out.Primitives, np)
	}

	// morph 权重（直拷）
	if len(srcMesh.Weights) > 0 {
		cp := make([]float64, len(srcMesh.Weights))
		copy(cp, srcMesh.Weights)
		out.Weights = cp
	}

	dst.Meshes = append(dst.Meshes, out)
	return len(dst.Meshes) - 1, nil
}

/************* 用 modeler 读 → 在 dst 重建一个 primitive *************/

func clonePrimitive(src *gltf.Document, p *gltf.Primitive, dst *gltf.Document, fidx int) (*gltf.Primitive, error) {
	if p == nil {
		return nil, errors.New("nil primitive")
	}
	out := &gltf.Primitive{Mode: p.Mode}
	out.Attributes = make(gltf.PrimitiveAttributes)
	// POSITION
	if ai, ok := p.Attributes[gltf.POSITION]; ok {
		pos, err := modeler.ReadPosition(src, src.Accessors[ai], nil) // [][3]float32
		if err != nil {
			return nil, fmt.Errorf("ReadPosition: %w", err)
		}

		out.Attributes[gltf.POSITION] = modeler.WritePosition(dst, pos)

		if fidx != -1 {
			//添加属性
			feat := make([]uint16, len(pos))
			for j := range feat {
				feat[j] = uint16(fidx) // 你的 feature 行号
			}
			featAcc := modeler.WriteAccessor(dst, gltf.TargetArrayBuffer, feat)
			out.Attributes["_FEATURE_ID_0"] = featAcc

			out.Extensions = map[string]interface{}{
				"EXT_mesh_features": map[string]interface{}{
					"featureIds": []map[string]interface{}{
						{
							"attribute":     0, // _FEATURE_ID_0
							"propertyTable": 0,
						},
					},
				},
			}
		}

	}

	// NORMAL（可选）
	if ai, ok := p.Attributes[gltf.NORMAL]; ok {
		nrm, err := modeler.ReadNormal(src, src.Accessors[ai], nil) // [][3]float32
		if err != nil {
			return nil, fmt.Errorf("ReadNormal: %w", err)
		}
		out.Attributes[gltf.NORMAL] = modeler.WriteNormal(dst, nrm)
	}

	// TEXCOORD_0（可选）
	if ai, ok := p.Attributes[gltf.TEXCOORD_0]; ok {
		uv, err := modeler.ReadTextureCoord(src, src.Accessors[ai], nil) // [][2]float32
		if err != nil {
			return nil, fmt.Errorf("ReadTexCoord0: %w", err)
		}

		out.Attributes[gltf.TEXCOORD_0] = modeler.WriteTextureCoord(dst, uv)
	}
	// COLOR_0（可选）
	if ai, ok := p.Attributes[gltf.COLOR_0]; ok {
		uv, err := modeler.ReadColor(src, src.Accessors[ai], nil) // [][2]float32
		if err != nil {
			return nil, fmt.Errorf("ReadTexCoord0: %w", err)
		}

		out.Attributes[gltf.COLOR_0] = modeler.WriteColor(dst, uv)
	}

	// indices（可选）
	if p.Indices != nil {
		idx, err := modeler.ReadIndices(src, src.Accessors[*p.Indices], nil) // []uint32
		if err != nil {
			return nil, fmt.Errorf("ReadIndices: %w", err)
		}

		out.Indices = gltf.Index(modeler.WriteIndices(dst, idx))
	}

	// material（完整克隆见下个函数）
	out.Material = p.Material
	return out, nil
}
