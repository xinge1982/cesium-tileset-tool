/************* 贴图链克隆（Image/Sampler/Texture/Material） *************/
type matCopier struct {
	src, dst           *gltf.Document
	imgMap, samplerMap map[int]int
	texMap, matMap     map[int]int
}

func newMatCopier(src, dst *gltf.Document) *matCopier {
	return &matCopier{
		src: src, dst: dst,
		imgMap:     map[int]int{},
		samplerMap: map[int]int{},
		texMap:     map[int]int{},
		matMap:     map[int]int{},
	}
}

func (m *matCopier) cloneImage(i int) (int, error) {
	if ni, ok := m.imgMap[i]; ok {
		return ni, nil
	}
	img := m.src.Images[i]
	if img == nil {
		return -1, fmt.Errorf("nil image %d", i)
	}
	if img.BufferView == nil {
		return -1, fmt.Errorf("image %d has no BufferView (expect GLB)", i)
	}
	bv := m.src.BufferViews[*img.BufferView]
	if bv == nil {
		return -1, fmt.Errorf("invalid image bufferview %d", i)
	}
	buf := m.src.Buffers[bv.Buffer]
	if buf == nil || len(buf.Data) == 0 {
		return -1, fmt.Errorf("empty buffer for image %d", i)
	}

	base := bv.ByteOffset
	end := base + bv.ByteLength
	if end > len(buf.Data) {
		return -1, fmt.Errorf("image overflow")
	}
	data := buf.Data[base:end]

	bufIdx, off := appendBytesAligned(m.dst, data)
	m.dst.BufferViews = append(m.dst.BufferViews, &gltf.BufferView{
		Buffer:     bufIdx,
		ByteOffset: off,
		ByteLength: len(data),
	})
	newBV := len(m.dst.BufferViews) - 1

	cp := &gltf.Image{
		BufferView: gltf.Index(newBV),
		MimeType:   img.MimeType,
		Name:       img.Name,
	}
	m.dst.Images = append(m.dst.Images, cp)
	newIdx := len(m.dst.Images) - 1
	m.imgMap[i] = newIdx
	return newIdx, nil
}

func (m *matCopier) cloneSampler(i int) (int, error) {
	if ni, ok := m.samplerMap[i]; ok {
		return ni, nil
	}
	s := m.src.Samplers[i]
	if s == nil {
		return -1, fmt.Errorf("nil sampler %d", i)
	}
	cp := *s
	m.dst.Samplers = append(m.dst.Samplers, &cp)
	newIdx := len(m.dst.Samplers) - 1
	m.samplerMap[i] = newIdx
	return newIdx, nil
}
func (m *matCopier) cloneTexture(i int) (int, error) {

	if ni, ok := m.texMap[i]; ok {
		return ni, nil
	}
	tx := m.src.Textures[i]
	if tx == nil {
		return -1, fmt.Errorf("nil texture %d", i)
	}
	cp := *tx
	if tx.Source != nil {
		ii, err := m.cloneImage(*tx.Source)
		if err != nil {
			return -1, err
		}
		cp.Source = gltf.Index(ii)
	}
	if tx.Sampler != nil {
		si, err := m.cloneSampler(*tx.Sampler)
		if err != nil {
			return -1, err
		}
		cp.Sampler = gltf.Index(si)
	}
	m.dst.Textures = append(m.dst.Textures, &cp)
	newIdx := len(m.dst.Textures) - 1
	m.texMap[i] = newIdx
	return newIdx, nil
}
func (m *matCopier) cloneMaterial(i int) (int, error) {
	if ni, ok := m.matMap[i]; ok {
		return ni, nil
	}
	mat := m.src.Materials[i]
	if mat == nil {
		return -1, fmt.Errorf("nil material %d", i)
	}
	cp := *mat
	// PBR
	if mat.PBRMetallicRoughness != nil {
		mr := *mat.PBRMetallicRoughness
		if mr.BaseColorTexture != nil {
			ti, err := m.cloneTexture(mr.BaseColorTexture.Index)
			if err != nil {
				return -1, err
			}
			t := *mr.BaseColorTexture
			t.Index = ti
			mr.BaseColorTexture = &t
		}
		if mr.MetallicRoughnessTexture != nil {
			ti, err := m.cloneTexture(mr.MetallicRoughnessTexture.Index)
			if err != nil {
				return -1, err
			}
			t := *mr.MetallicRoughnessTexture
			t.Index = ti
			mr.MetallicRoughnessTexture = &t
		}
		cp.PBRMetallicRoughness = &mr
	}
	if mat.NormalTexture != nil && mat.NormalTexture.Index != nil {
		ti, err := m.cloneTexture(*mat.NormalTexture.Index)
		if err != nil {
			return -1, err
		}
		t := *mat.NormalTexture
		t.Index = gltf.Index(ti)
		cp.NormalTexture = &t
	}
	if mat.OcclusionTexture != nil && mat.OcclusionTexture.Index != nil {
		ti, err := m.cloneTexture(*mat.OcclusionTexture.Index)
		if err != nil {
			return -1, err
		}
		t := *mat.OcclusionTexture
		t.Index = gltf.Index(ti)
		cp.OcclusionTexture = &t
	}
	if mat.EmissiveTexture != nil {
		ti, err := m.cloneTexture(mat.EmissiveTexture.Index)
		if err != nil {
			return -1, err
		}
		t := *mat.EmissiveTexture
		t.Index = ti
		cp.EmissiveTexture = &t
	}
	m.dst.Materials = append(m.dst.Materials, &cp)
	newIdx := len(m.dst.Materials) - 1
	m.matMap[i] = newIdx
	return newIdx, nil
}

/************* 用 modeler 读 → 在 dst 重建一个 primitive *************/
func rebuildPrimitiveWithModeler(src *gltf.Document, p *gltf.Primitive, dst *gltf.Document) (*gltf.Primitive, error) {
	if p == nil {
		return nil, errors.New("nil primitive")
	}
	out := &gltf.Primitive{Mode: p.Mode}
	out.Attributes = make(gltf.PrimitiveAttributes)
	// POSITION
	if ai, ok := p.Attributes[gltf.POSITION]; ok {
		pos, err := modeler.ReadPosition(src, src.Accessors[ai], nil) // [][3]float32
		if err != nil {
			return nil, fmt.Errorf("ReadPosition: %w", err)
		}

		out.Attributes[gltf.POSITION] = modeler.WritePosition(dst, pos)
	}

	// NORMAL（可选）
	if ai, ok := p.Attributes[gltf.NORMAL]; ok {
		nrm, err := modeler.ReadNormal(src, src.Accessors[ai], nil) // [][3]float32
		if err != nil {
			return nil, fmt.Errorf("ReadNormal: %w", err)
		}
		out.Attributes[gltf.NORMAL] = modeler.WriteNormal(dst, nrm)
	}

	// TEXCOORD_0（可选）
	if ai, ok := p.Attributes[gltf.TEXCOORD_0]; ok {
		uv, err := modeler.ReadTextureCoord(src, src.Accessors[ai], nil) // [][2]float32
		if err != nil {
			return nil, fmt.Errorf("ReadTexCoord0: %w", err)
		}

		out.Attributes[gltf.TEXCOORD_0] = modeler.WriteTextureCoord(dst, uv)
	}
	// COLOR_0（可选）
	if ai, ok := p.Attributes[gltf.COLOR_0]; ok {
		uv, err := modeler.ReadColor(src, src.Accessors[ai], nil) // [][2]float32
		if err != nil {
			return nil, fmt.Errorf("ReadTexCoord0: %w", err)
		}

		out.Attributes[gltf.COLOR_0] = modeler.WriteColor(dst, uv)
	}

	// indices（可选）
	if p.Indices != nil {
		idx, err := modeler.ReadIndices(src, src.Accessors[*p.Indices], nil) // []uint32
		if err != nil {
			return nil, fmt.Errorf("ReadIndices: %w", err)
		}

		out.Indices = gltf.Index(modeler.WriteIndices(dst, idx))
	}

	// material（完整克隆见下个函数）
	out.Material = p.Material
	return out, nil
}

//CloneMeshWithModeler
/************* Mesh 克隆（重建几何 + 克隆材质贴图链） *************/
func CloneMeshWithModeler(src *gltf.Document, meshIndex int, dst *gltf.Document) (int, error) {
	if src == nil || dst == nil {
		return -1, errors.New("nil doc")
	}
	if meshIndex < 0 || meshIndex >= len(src.Meshes) || src.Meshes[meshIndex] == nil {
		return -1, fmt.Errorf("invalid mesh index %d", meshIndex)
	}
	ensureSingleBuffer(dst)
	mc := newMatCopier(src, dst)

	srcMesh := src.Meshes[meshIndex]
	out := &gltf.Mesh{Name: srcMesh.Name}
	out.Primitives = make([]*gltf.Primitive, 0, len(srcMesh.Primitives))

	for i, p := range srcMesh.Primitives {
		if p == nil {
			continue
		}
		np, err := rebuildPrimitiveWithModeler(src, p, dst)
		if err != nil {
			return -1, fmt.Errorf("primitive %d: %w", i, err)
		}

		// 克隆材质链（若有）
		if p.Material != nil {
			newMat, err := mc.cloneMaterial(*p.Material)
			if err != nil {
				return -1, fmt.Errorf("material %d: %w", *p.Material, err)
			}
			np.Material = gltf.Index(newMat)
		}
		out.Primitives = append(out.Primitives, np)
	}

	// morph 权重（直拷）
	if len(srcMesh.Weights) > 0 {
		cp := make([]float64, len(srcMesh.Weights))
		copy(cp, srcMesh.Weights)
		out.Weights = cp
	}

	dst.Meshes = append(dst.Meshes, out)
	return len(dst.Meshes) - 1, nil
}

